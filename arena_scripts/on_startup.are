/*
 * ============================================================================
 * NetModule NB800 Router - Arena Scripting Language
 * Dosya Adi: on_startup.are
 * 
 * ISLEV VE GOREV TANIMI:
 * Bu betik, NetModule NB800 yonlendirici enerjilendikten ve NRSW isletim
 * sistemi baslatma surecini basariyla tamamladiktan hemen sonra tetiklenen
 * olay gudumlu (event-driven) mikro betiktir.
 * 
 * Gorevleri:
 * 1. 127.0.0.1:1883 dahili Mosquitto MQTT brokerina anlik baglanir.
 * 2. local/event/system konusuna sistemin acildigini bildiren
 *    {"event": "startup", "timestamp": <ts>} JSON paketini yayinlar (Retain: 1).
 * 3. LXC konteyner katmanindaki servislerin ve diger bilesenlerin sistemin
 *    hazir oldugunu anlamasini saglar.
 * 4. MQTT baglantisini kapatir ve sonlanir.
 * 
 * TETIKLEYICI (TRIGGER) BILGISI:
 *   NRSW Olay Kodu  : 505
 *   NRSW Olay Adi   : system-startup (Router operating system boot completed)
 *   Tetikleme Modu  : Ephemeral Olay Betigi (Event Handler)
 *   NRSW Job Ayari  : System -> SDK -> Jobs menusunden Trigger Event olarak
 *                     505 (system-startup) secilerek bu betik baglanir.
 *   Kritik Not      : Betik sonsuz dongu icermez, calisir ve exit(0) ile biter.
 * ============================================================================
 */

/* Broker ve Yayin Sabitleri */
BROKER_HOST = "127.0.0.1";
BROKER_PORT = 1883;
CLIENT_ID   = "nb800_ev_startup";
TOPIC_SYSTEM = "local/event/system";

/* Olay Zamani */
now_ts = time();
payload = sprintf('{"event": "startup", "timestamp": %d}', now_ts);

nb_syslog("Olay Tetiklendi [505 system-startup]: %s", payload);

/* Dahili Brokera Baglanti ve Yayin */
published = false;
mh = nb_mqttlib_new(CLIENT_ID, true);
if (mh >= 0) {
    conn = nb_mqttlib_connect(mh, BROKER_HOST, BROKER_PORT, 10, mkarray());
    if (conn == 0) {
        cb = nb_mqttlib_get_callback_connect(mh, 1000, mkarray());
        if (!is_void(cb)) {
            pub_res = nb_mqttlib_publish(mh, TOPIC_SYSTEM, payload, 0, 1, mkarray());
            if (pub_res == 0) {
                published = true;
                nb_syslog("MQTT [505 system-startup] bildirimi yayinlandi -> Topic: %s", TOPIC_SYSTEM);
            } else {
                nb_syslog("HATA: MQTT [505 system-startup] yayinlanamadi (Kod: %d)", pub_res);
            }
        } else {
            nb_syslog("HATA: MQTT [505 system-startup] CONNACK zaman asimi");
        }
        sleep(1);
        nb_mqttlib_disconnect(mh, 0, mkarray());
    } else {
        nb_syslog("HATA: Dahili brokera baglanilamadi (Kod: %d)", conn);
    }
    nb_mqttlib_free(mh);
} else {
    nb_syslog("HATA: MQTT handle olusturulamadi (Kod: %d)", mh);
}

if (!published) {
    fb_res = nb_mqtt_publish(BROKER_HOST, BROKER_PORT, "", "", TOPIC_SYSTEM, 0, 1, payload);
    if (fb_res == 0) {
        nb_syslog("MQTT [505 system-startup] fallback ile yayinlandi (nb_mqtt_publish)");
    }
}

exit(0);
