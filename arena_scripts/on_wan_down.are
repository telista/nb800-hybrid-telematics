/*
 * ============================================================================
 * NetModule NB800 Router - Arena Scripting Language
 * Dosya Adi: on_wan_down.are
 * 
 * ISLEV VE GOREV TANIMI:
 * Bu betik, NetModule NB800 yonlendiricide hucresel (WWAN) veya harici WAN
 * baglantisi koptugunda tetiklenen olay gudumlu (event-driven) mikro betiktir.
 * 
 * Gorevleri:
 * 1. 127.0.0.1:1883 dahili Mosquitto MQTT brokerina anlik baglanir.
 * 2. local/event/wan konusuna baglantinin koptugunu bildiren
 *    {"state": "down", "interface": "Mobile1", "timestamp": <ts>} JSON paketini
 *    yayinlar (Retain: 1).
 * 3. LXC konteyneri icindeki lxc_agent bu bildirimi aldigi milisaniyede
 *    sifir gecikmeyle Store-and-Forward (cevrimdisi dosyaya depolama) moduna
 *    gecer ve veri kaybini onler.
 * 4. MQTT baglantisini duzgun sekilde kapatir ve sonlanir.
 * 
 * TETIKLEYICI (TRIGGER) BILGISI:
 *   NRSW Olay Kodu  : 102
 *   NRSW Olay Adi   : wan-down (WAN link disconnected / cellular link lost)
 *   Tetikleme Modu  : Ephemeral Olay Betigi (Event Handler)
 *   NRSW Job Ayari  : System -> SDK -> Jobs menusunden Trigger Event olarak
 *                     102 (wan-down) secilerek bu betik baglanir.
 *   Kritik Not      : Betik sonsuz dongu icermez, calisir ve exit(0) ile biter.
 * ============================================================================
 */

/* Broker ve Yayin Sabitleri */
BROKER_HOST = "127.0.0.1";
BROKER_PORT = 1883;
CLIENT_ID   = "nb800_ev_wan_down";
TOPIC_WAN   = "local/event/wan";
WAN_IFACE   = "Mobile1";

/* Olay Zamani */
now_ts = time();
payload = sprintf('{"state": "down", "interface": "%s", "timestamp": %d}', WAN_IFACE, now_ts);

nb_syslog("Olay Tetiklendi [102 wan-down]: %s", payload);

/* Dahili Brokera Baglanti ve Yayin */
published = false;
mh = nb_mqttlib_new(CLIENT_ID, true);
if (mh >= 0) {
    conn = nb_mqttlib_connect(mh, BROKER_HOST, BROKER_PORT, 10, mkarray());
    if (conn == 0) {
        cb = nb_mqttlib_get_callback_connect(mh, 1000, mkarray());
        if (!is_void(cb)) {
            pub_res = nb_mqttlib_publish(mh, TOPIC_WAN, payload, 0, 1, mkarray());
            if (pub_res == 0) {
                published = true;
                nb_syslog("MQTT [102 wan-down] bildirimi yayinlandi -> Topic: %s", TOPIC_WAN);
            } else {
                nb_syslog("HATA: MQTT [102 wan-down] yayinlanamadi (Kod: %d)", pub_res);
            }
        } else {
            nb_syslog("HATA: MQTT [102 wan-down] CONNACK zaman asimi");
        }
        sleep(1);
        nb_mqttlib_disconnect(mh, 0, mkarray());
    } else {
        nb_syslog("HATA: Dahili brokera baglanilamadi (Kod: %d)", conn);
    }
    nb_mqttlib_free(mh);
} else {
    nb_syslog("HATA: MQTT handle olusturulamadi (Kod: %d)", mh);
}

if (!published) {
    fb_res = nb_mqtt_publish(BROKER_HOST, BROKER_PORT, "", "", TOPIC_WAN, 0, 1, payload);
    if (fb_res == 0) {
        nb_syslog("MQTT [102 wan-down] fallback ile yayinlandi (nb_mqtt_publish)");
    }
}

exit(0);
