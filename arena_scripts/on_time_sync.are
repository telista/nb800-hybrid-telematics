/*
 * ============================================================================
 * NetModule NB800 Router - Arena Scripting Language
 * Dosya Adi: on_time_sync.are
 * 
 * ISLEV VE GOREV TANIMI:
 * Bu betik, NetModule NB800 yonlendiricinin sistem saati NTP (Network Time
 * Protocol) veya GPS uydulari uzerinden guncellendiginde ve dogrulandiginda
 * tetiklenen olay gudumlu (event-driven) mikro betiktir.
 * 
 * Gorevleri:
 * 1. 127.0.0.1:1883 dahili Mosquitto MQTT brokerina anlik baglanir.
 * 2. local/event/time konusuna zaman senkronizasyonunun tamamlandigini bildiren
 *    {"state": "sync", "timestamp": <ts>} JSON paketini yayinlar (Retain: 1).
 * 3. NB800 donaniminda pil destekli RTC (Real-Time Clock) bulunmadigi icin,
 *    cihaz hard power cut sonrasi acildiginda saati 01.01.1970 olarak baslatabilir.
 *    LXC konteynerindeki lxc_agent bu 508 olay bildirimini aldiktan sonra
 *    gercek zaman farkini (offset) hesaplar ve ilk 15-40 saniyede uretilen
 *    gecici etiketli kayitlarin zaman damgalarini geriye donuk olarak yamalar
 *    (timestamp back-patching). Boylece merkeze 1970 tarihli gecersiz telemetri
 *    gitmesi onlenir.
 * 4. MQTT baglantisini kapatir ve sonlanir.
 * 
 * TETIKLEYICI (TRIGGER) BILGISI:
 *   NRSW Olay Kodu  : 508
 *   NRSW Olay Adi   : system-time-updated (System time synchronized via NTP/GPS)
 *   Tetikleme Modu  : Ephemeral Olay Betigi (Event Handler)
 *   NRSW Job Ayari  : System -> SDK -> Jobs menusunden Trigger Event olarak
 *                     508 (system-time-updated) secilerek bu betik baglanir.
 *   Kritik Not      : Betik sonsuz dongu icermez, calisir ve exit(0) ile biter.
 * ============================================================================
 */

/* Broker ve Yayin Sabitleri */
BROKER_HOST = "127.0.0.1";
BROKER_PORT = 1883;
CLIENT_ID   = "nb800_ev_time_sync";
TOPIC_TIME   = "local/event/time";

/* Guncel Senkronize Zaman */
now_ts = time();
payload = sprintf('{"state": "sync", "timestamp": %d}', now_ts);

nb_syslog("Olay Tetiklendi [508 system-time-updated]: %s", payload);

/* Dahili Brokera Baglanti ve Yayin */
published = false;
mh = nb_mqttlib_new(CLIENT_ID, true);
if (mh >= 0) {
    conn = nb_mqttlib_connect(mh, BROKER_HOST, BROKER_PORT, 10, mkarray());
    if (conn == 0) {
        cb = nb_mqttlib_get_callback_connect(mh, 1000, mkarray());
        if (!is_void(cb)) {
            pub_res = nb_mqttlib_publish(mh, TOPIC_TIME, payload, 0, 1, mkarray());
            if (pub_res == 0) {
                published = true;
                nb_syslog("MQTT [508 system-time-updated] bildirimi yayinlandi -> Topic: %s", TOPIC_TIME);
            } else {
                nb_syslog("HATA: MQTT [508 system-time-updated] yayinlanamadi (Kod: %d)", pub_res);
            }
        } else {
            nb_syslog("HATA: MQTT [508 system-time-updated] CONNACK zaman asimi");
        }
        sleep(1);
        nb_mqttlib_disconnect(mh, 0, mkarray());
    } else {
        nb_syslog("HATA: Dahili brokera baglanilamadi (Kod: %d)", conn);
    }
    nb_mqttlib_free(mh);
} else {
    nb_syslog("HATA: MQTT handle olusturulamadi (Kod: %d)", mh);
}

if (!published) {
    fb_res = nb_mqtt_publish(BROKER_HOST, BROKER_PORT, "", "", TOPIC_TIME, 0, 1, payload);
    if (fb_res == 0) {
        nb_syslog("MQTT [508 system-time-updated] fallback ile yayinlandi (nb_mqtt_publish)");
    }
}

exit(0);
