/*
 * ============================================================================
 * NetModule NB800 Router - Arena Scripting Language
 * Dosya Adi: on_gps_down.are
 * 
 * ISLEV VE GOREV TANIMI:
 * Bu betik, NetModule NB800 yonlendiricinin dahili GNSS/GPS modulunun uydu
 * kilitlenmesi kayboldugunda (tunel, kapali otopark, kanyon etkisi veya anten
 * sinyal kaybi) tetiklenen olay gudumlu (event-driven) mikro betiktir.
 * 
 * Gorevleri:
 * 1. 127.0.0.1:1883 dahili Mosquitto MQTT brokerina anlik baglanir.
 * 2. local/event/gps konusuna GPS kilitlenmesinin kayboldugunu bildiren
 *    {"state": "down", "timestamp": <ts>} JSON paketini yayinlar (Retain: 1).
 * 3. LXC konteyneri icindeki lxc_agent bu olayi yakalayarak gelecek telemetrileri
 *    aninda gecersiz (invalid fix) olarak etiketler veya son gecerli koordinati
 *    merkeze alarm bayragiyla iletir.
 * 4. MQTT baglantisini guvenli sekilde kapatir ve sonlanir.
 * 
 * TETIKLEYICI (TRIGGER) BILGISI:
 *   NRSW Olay Kodu  : 302
 *   NRSW Olay Adi   : gps-down (GNSS fix lost / satellite tracking lost)
 *   Tetikleme Modu  : Ephemeral Olay Betigi (Event Handler)
 *   NRSW Job Ayari  : System -> SDK -> Jobs menusunden Trigger Event olarak
 *                     302 (gps-down) secilerek bu betik baglanir.
 *   Kritik Not      : Betik sonsuz dongu icermez, calisir ve exit(0) ile biter.
 * ============================================================================
 */

/* Broker ve Yayin Sabitleri */
BROKER_HOST = "127.0.0.1";
BROKER_PORT = 1883;
CLIENT_ID   = "nb800_ev_gps_down";
TOPIC_GPS   = "local/event/gps";

/* Olay Zamani */
now_ts = time();
payload = sprintf('{"state": "down", "timestamp": %d}', now_ts);

nb_syslog("Olay Tetiklendi [302 gps-down]: %s", payload);

/* Dahili Brokera Baglanti ve Yayin */
published = false;
mh = nb_mqttlib_new(CLIENT_ID, true);
if (mh >= 0) {
    conn = nb_mqttlib_connect(mh, BROKER_HOST, BROKER_PORT, 10, mkarray());
    if (conn == 0) {
        /* Asenkron baglanti el sikismasini (CONNACK) bekle */
        cb = nb_mqttlib_get_callback_connect(mh, 1000, mkarray());
        if (!is_void(cb)) {
            pub_res = nb_mqttlib_publish(mh, TOPIC_GPS, payload, 0, 1, mkarray());
            if (pub_res == 0) {
                published = true;
                nb_syslog("MQTT [302 gps-down] bildirimi yayinlandi -> Topic: %s", TOPIC_GPS);
            } else {
                nb_syslog("HATA: MQTT [302 gps-down] yayinlanamadi (Kod: %d)", pub_res);
            }
        } else {
            nb_syslog("HATA: MQTT [302 gps-down] CONNACK zaman asimi");
        }
        /* Soket tamponunun TCP katmaninca iletilmesi icin bekle */
        sleep(1);
        nb_mqttlib_disconnect(mh, 0, mkarray());
    } else {
        nb_syslog("HATA: Dahili brokera baglanilamadi (Kod: %d)", conn);
    }
    nb_mqttlib_free(mh);
} else {
    nb_syslog("HATA: MQTT handle olusturulamadi (Kod: %d)", mh);
}

/* Fallback: Senkron yayinlama */
if (!published) {
    fb_res = nb_mqtt_publish(BROKER_HOST, BROKER_PORT, "", "", TOPIC_GPS, 0, 1, payload);
    if (fb_res == 0) {
        nb_syslog("MQTT [302 gps-down] fallback ile yayinlandi (nb_mqtt_publish)");
    }
}

exit(0);
